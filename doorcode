#include <LiquidCrystal.h>
#include <Keypad.h>
#include <Servo.h>

// LCD: RS, E, D4, D5, D6, D7
LiquidCrystal lcd(A0, A1, A2, A3, A4, A5);

// Keypad configuration
const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'}
};

byte rowPins[ROWS] = {2, 3, 4, 5};
byte colPins[COLS] = {6, 7, 8, 9};

Keypad keypad = Keypad(
  makeKeymap(keys),
  rowPins,
  colPins,
  ROWS,
  COLS
);

// Servo and buzzer
Servo doorServo;

const int servoPin = 10;
const int buzzerPin = 11;

// Password settings
String correctPassword = "1346";
String enteredPassword = "";

int wrongAttempts = 0;
const int maxAttempts = 3;

// Door positions
const int LOCK_POSITION = 0;
const int UNLOCK_POSITION = 90;

// Door state
bool doorUnlocked = false;
unsigned long unlockTime = 0;
const unsigned long unlockDuration = 5000;

bool lockedOut = false;

void setup() {

  lcd.begin(16, 2);

  doorServo.attach(servoPin);
  doorServo.write(LOCK_POSITION);

  pinMode(buzzerPin, OUTPUT);

  lcd.setCursor(0, 0);
  lcd.print("SMART DOOR LOCK");

  lcd.setCursor(0, 1);
  lcd.print("System Starting");

  delay(2000);

  showPasswordScreen();
}

void loop() {

  // Automatically lock door after 5 seconds
  if (doorUnlocked &&
      millis() - unlockTime >= unlockDuration) {

    lockDoor();
  }

  // Security lockout
  if (lockedOut) {
    return;
  }

  char key = keypad.getKey();

  if (key) {

    // Clear entered password
    if (key == '*') {

      enteredPassword = "";
      showPasswordScreen();

    }

    // Submit password
    else if (key == '#') {

      checkPassword();

    }

    // Enter password
    else if (enteredPassword.length() < 8) {

      enteredPassword += key;

      lcd.setCursor(0, 1);
      lcd.print("                ");

      lcd.setCursor(0, 1);
      for (int i = 0; i < enteredPassword.length(); i++) {
        lcd.print("*");
      }
    }
  }
}

void showPasswordScreen() {

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Enter Password:");

  lcd.setCursor(0, 1);
  lcd.print("                ");
}

void checkPassword() {

  if (enteredPassword == correctPassword) {

    wrongAttempts = 0;
    unlockDoor();

  } else {

    wrongAttempts++;

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Wrong Password!");

    tone(buzzerPin, 1000, 500);

    lcd.setCursor(0, 1);
    lcd.print("Attempts: ");
    lcd.print(wrongAttempts);

    delay(1500);

    enteredPassword = "";

    if (wrongAttempts >= maxAttempts) {

      lockedOut = true;

      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("SYSTEM LOCKED!");

      lcd.setCursor(0, 1);
      lcd.print("Too Many Errors");

      tone(buzzerPin, 1500, 10000);

      return;
    }

    showPasswordScreen();
  }
}

void unlockDoor() {

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Access Granted!");

  lcd.setCursor(0, 1);
  lcd.print("Door Unlocked");

  tone(buzzerPin, 1500, 150);

  doorServo.write(UNLOCK_POSITION);

  doorUnlocked = true;
  unlockTime = millis();

  enteredPassword = "";
}

void lockDoor() {

  doorServo.write(LOCK_POSITION);

  doorUnlocked = false;

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Door Locked");

  lcd.setCursor(0, 1);
  lcd.print("System Ready");

  delay(1500);

  enteredPassword = "";

  showPasswordScreen();
}
